NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical browser origin used for production auth callbacks.
NEXT_PUBLIC_SITE_URL=https://www.myorderlyapp.com

# Required for closed-site Canvas background syncing and the durable,
# server-side account-deletion worker.
SUPABASE_SERVICE_ROLE_KEY=
# Recommended separate 32+ character secret. When omitted, the server-side
# service-role key is used to encrypt and authenticate short-lived password-recovery capabilities.
PASSWORD_RECOVERY_SIGNING_SECRET=
# Shared server-only bearer secret for both the Canvas scheduler and account
# deletion worker. Never prefix it with NEXT_PUBLIC_.
CANVAS_SYNC_CRON_SECRET=

# Server-only Assistant configuration. Never expose the API key through a
# NEXT_PUBLIC_ variable.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Server-only Assistant controls. Provider token usage is always logged.
AI_ASSISTANT_ENABLED=true
# Daily/monthly message quotas are temporarily disabled by default. Per-minute
# abuse protection remains active. Re-enable quotas only after applying the
# current Assistant usage migration.
AI_ASSISTANT_MESSAGE_LIMITS_ENABLED=false
DEEPSEEK_DAILY_MESSAGE_LIMIT=10
DEEPSEEK_MONTHLY_MESSAGE_LIMIT=100
# Per-account burst protection; this is not a daily/monthly chat quota.
DEEPSEEK_REQUESTS_PER_MINUTE=12
